  "views": {
    "public.bounty_funding_totals": {
      "columns": {
        "bounty_id": {
          "name": "bounty_id",
          "type": "uuid",
          "primaryKey": false,
          "notNull": true
        },
        "funded_cents": {
          "name": "funded_cents",
          "type": "integer",
          "primaryKey": false,
          "notNull": true
        },
        "sponsor_count": {
          "name": "sponsor_count",
          "type": "integer",
          "primaryKey": false,
          "notNull": true
        }
      },
      "definition": "\n  SELECT b.id AS bounty_id,\n         COALESCE(SUM(f.amount_cents), 0)::integer AS funded_cents,\n         COUNT(f.id)::integer AS sponsor_count\n  FROM \"bounties\" b\n  LEFT JOIN \"bounty_funds\" f ON f.bounty_id = b.id\n  GROUP BY b.id\n",
      "name": "bounty_funding_totals",
      "schema": "public",
      "isExisting": false,
      "materialized": false
    }
  },
