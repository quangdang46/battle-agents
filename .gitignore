# reference repos for research only — never commit (large, third-party)
.tmp/

# deps
node_modules/
.pnp
.pnp.js

# build
.next/
out/
dist/
build/

# env & secrets
.env
.env*.local
*.pem
*.key

# OS / editor
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/

# test / cache
coverage/
.turbo

# bv (beads viewer) local config and caches
.bv/

# beads tracker: transient SQLite lock/vacuum/gate sidecars left behind when a
# `br` run is interrupted. .beads/.gitignore covers *.db and *.lock but not
# these suffixes, so they showed up as untracked noise in every `git status`.
.beads/*-lock-*
.beads/*-fsqlite-*
.beads/*-wal-cert*
.beads/.beads.vacuum.*
.beads/beads.db.fsqlite-migration-state

# pnpm local content-addressable store
.pnpm-store/

# Claude Code local agent worktrees (session infrastructure, not project files)
.claude/worktrees/

# TypeScript incremental build state
*.tsbuildinfo

# Throwaway helpers. A script that edits the tree by anchor and dies on the
# second run is scaffolding, and scaffolding in a repository is a trap: the
# next person runs it, it corrupts a file, and the commit message is the only
# record of what it was for.
tmp-*
*.bak
